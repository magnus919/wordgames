{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "answer", "clue", "note", "accepted_answers"],
  "properties": {
    "language": {
      "const": "en"
    },
    "answer": {
      "type": "string",
      "pattern": "^[A-Z]{6}$",
      "minLength": 6,
      "maxLength": 6
    },
    "clue": {
      "type": "string",
      "minLength": 12,
      "maxLength": 180
    },
    "note": {
      "type": "string",
      "minLength": 12,
      "maxLength": 240
    },
    "accepted_answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{6}$"
      }
    }
  }
}
