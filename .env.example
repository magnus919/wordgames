# Compose reads this file for substitution; explicitly listed settings are passed
# to containers. Copy to .env, or supply --env-file /path/to/settings.env.
COMPOSE_FILE=compose.yaml
COMPOSE_PROJECT_NAME=wordgames

# Initial PostgreSQL identity. Use URL-safe values; see docs/configuration.md.
POSTGRES_DB=wordgames
POSTGRES_USER=wordgames
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Only the web port is published; PostgreSQL stays on the private network.
PORT=8080
WEB_BIND=127.0.0.1
GAMES_PATH=./games
RUST_LOG=wordgames=info,tower_http=info

# LLM settings are passed only to the Rust generator worker.
# Full HTTPS OpenAI-compatible chat-completions URL; not just a base URL.
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=

# Five numeric cron fields, quoted to preserve spaces. Scheduler uses UTC.
CRON_SCHEDULE='17 3 * * *'
GENERATE_ON_STARTUP=true

# Optional HTTPS deployment: set COMPOSE_FILE to
# compose.yaml:compose.production.yaml and configure these values.
SITE_DOMAIN=
ACME_EMAIL=
